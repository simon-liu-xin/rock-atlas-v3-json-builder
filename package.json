{
  "name": "rock-atlas-v3-json-builder",
  "version": "3.0.0",
  "private": true,
  "description": "An evidence-first, downloadable rock music knowledge graph.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22.18.0 <23",
    "npm": ">=10.9.0 <11"
  },
  "scripts": {
    "data:frontend:sync": "node scripts/sync-frontend.mjs",
    "data:catalog:v3": "node scripts/build-current-catalog-v3.mjs",
    "data:full:export": "node scripts/offline-data/export_full_frontend_jsonl.mjs",
    "data:full:publish": "node scripts/offline-data/publish_offline_generation.mjs",
    "data:full:keygen": "node scripts/offline-data/generate_catalog_signing_key.mjs",
    "data:gate-a": "node scripts/build-catalog-gate-a-report.mjs",
    "data:gate-evidence": "node scripts/write-catalog-gate-evidence.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "papaparse": "5.5.4"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/papaparse": "5.5.2",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
